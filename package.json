{
  "name": "hoopdle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "HOOPDLE - a Wordle-style NBA player guessing game in 8-bit retro style",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "data": "node scripts/run-python.mjs scripts/fetch_players.py",
    "data:test": "node scripts/run-python.mjs -m unittest discover -s scripts -p \"test_*.py\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0"
  }
}
